\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Reproduction score by pipeline stage for three papers (\emph  {bridging-data-gaps}, \emph  {stochastic-interpolants}, \emph  {all-in-one}). The four bars per paper follow the build path of Figure\nobreakspace  {}\ref  {fig:workflow}: the \textbf  {Paper2Code} baseline, the freshly synthesized \textbf  {Codebase}, the \textbf  {Iteratively-Fixed Codebase} (static repair), and the \textbf  {Codebase with Dataset Runner} (baseline wiring and dataset-loading). Every stage clears the Paper2Code baseline, but the score is \emph  {not monotone} across stages: a repair or baseline-wiring edit can lower the score relative to the stage before it.\relax }}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:pipeline_scores}{{2}{9}{Reproduction score by pipeline stage for three papers (\emph {bridging-data-gaps}, \emph {stochastic-interpolants}, \emph {all-in-one}). The four bars per paper follow the build path of Figure~\ref {fig:workflow}: the \textbf {Paper2Code} baseline, the freshly synthesized \textbf {Codebase}, the \textbf {Iteratively-Fixed Codebase} (static repair), and the \textbf {Codebase with Dataset Runner} (baseline wiring and dataset-loading). Every stage clears the Paper2Code baseline, but the score is \emph {not monotone} across stages: a repair or baseline-wiring edit can lower the score relative to the stage before it.\relax }{figure.caption.12}{}}
